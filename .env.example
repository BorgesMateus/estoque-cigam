# Copie para .env e preencha. O .env NAO vai para o git.
# Os mesmos valores estao configurados em GitHub Secrets (Settings > Secrets and variables > Actions).

# --- CIGAM (somente leitura) ---
CIGAM_USER=
CIGAM_PASS=
CIGAM_PORTAL=
# CIGAM_BASE=https://<instancia>.cigam.cloud/api/api

# --- Supabase ---
SUPABASE_URL=https://<ref>.supabase.co
# service key: ignora RLS, so em ambiente de robo. Nunca no painel, nunca no navegador.
SUPABASE_SERVICE_KEY=
# usado apenas pelo workflow "Rodar SQL (Supabase)" (Management API)
SUPABASE_ACCESS_TOKEN=

# --- Alertas (opcionais) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=

# --- Relatorio por WhatsApp ---
# so digitos, com DDI e DDD
WA_NUMERO=
# alternativa ao numero: nome do grupo de destino
WA_GRUPO=

# --- Ajustes de execucao ---
# GRUPO=002              grupo de materiais monitorado
# DIAS=30                janela do robo de vendas (999 = backfill completo)
# GEOCEP_LIMITE=1200     faixas de CEP resolvidas por rodada
